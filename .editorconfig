# https://editorconfig.org
# UTF-8 em tudo: o projeto trata diacrítico como parte do texto, não como ruído.
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{json,yml,yaml,md}]
indent_size = 2

[*.md]
trim_trailing_whitespace = false  # dois espaços no fim fazem quebra de linha

[Makefile]
indent_style = tab
